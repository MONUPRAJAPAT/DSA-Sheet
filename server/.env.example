NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/dsa-sheet
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list of allowed browser origins (only needed when client and API are on different origins)
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the app (CloudFront + ALB = 2)
TRUST_PROXY=0
LOG_LEVEL=info
DEMO_EMAIL=demo@dsasheet.dev
DEMO_PASSWORD=Demo@1234
